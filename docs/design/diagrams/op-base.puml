@startuml op-base
title Op class structure

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1E293B
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam classBorderColor #64748B
skinparam classFontColor #0F172A
skinparam classAttributeFontColor #334155
skinparam classStereotypeFontColor #64748B
skinparam classBorderThickness 1.5
skinparam arrowColor #64748B
skinparam arrowFontColor #475569
skinparam arrowThickness 1.3
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 90
hide empty members

abstract class Op #E9EAF0 {
    contract : ClassVar[OpContract]
    _params
    _construction_facts
    last_call : CallRecord [property]
    __init__(params, target, kernel_map, tune)
    __call__(inputs)
    forward(inputs)
    _invoke(inputs)
    {abstract} _eager_forward(inputs)
    eval_roofline()
}

class ConcreteOp #F4F3F6 {
    _eager_forward(inputs)
}

class OpContract #E7EEF6 {
    _signature
    _interface_declarations
    _compile_schema
    _roofline_definition
    check_construction(params) : facts
    check_inputs(params, facts, inputs)
    check_result(call, result)
    infer_outputs(params, inputs)
}

class OpRuntime #E8F0E9 {
    _execution_policy
    _target_binding
    _kernel_entries
    _resources
    _delegates
    execute(op, inputs) : tuple[object, CallRecord]
    kernel_for(interface, call)
    resource_for(key, build)
    delegate_for(stage, key, given=None)
    call_delegate(stage, key, inputs)
    autotune()
    resource_view()
}

class OpObservation #EFE9F3 {
    last_call : CallRecord [property]
    record(call : CallRecord)
    resources(runtime : OpRuntime)
    eval_roofline(contract : OpContract)
}

class CallRecord <<value object>> #F7EEDC {
    kind : executed | empty
    params_and_call_facts
    shapes_and_dtypes
    effects
    metadata_snapshot
    stages
}

ConcreteOp --|> Op
Op "0..*" -down-> "1" OpContract : contract
Op "1" *-down- "1" OpRuntime : runtime
Op "1" *-down- "1" OpObservation : observation
OpContract -[hidden]right-> OpObservation
OpRuntime .down.> OpContract : validates
OpObservation "0..*" -down-> "0..1" CallRecord : last successful call
OpObservation .up.> OpRuntime : queries
OpObservation .left.> OpContract : roofline

@enduml
