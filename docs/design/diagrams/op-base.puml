@startuml op-base
title Op class structure

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #1E293B
skinparam titleFontColor #0F172A
skinparam titleFontSize 20
skinparam classBorderColor #64748B
skinparam classFontColor #0F172A
skinparam classFontStyle bold
skinparam classAttributeFontColor #334155
skinparam classStereotypeFontColor #64748B
skinparam classBorderThickness 1.5
skinparam arrowColor #64748B
skinparam arrowFontColor #475569
skinparam arrowThickness 1.3
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 90
hide empty members

abstract class "<color:#A65F52>Op</color>" as Op #E9EAF0 {
    _signature : _Plan [class attribute]
    _construction_ix
    _builder
    _built_entries
    _delegates
    last_call : SignatureCall [property]
    dispatch_kernel(kernel_map)
    __call__(inputs)
    _serve(inputs)
    {abstract} <color:#A65F52>forward(inputs)</color>
    {abstract} <color:#A65F52>_infer_output_shapes(shapes, dtypes)</color>
    {abstract} <color:#A65F52>_validate_dtypes(inputs)</color>
    {abstract} <color:#A65F52>eval_roofline()</color>
    kernel_for(interface, call)
    delegate_for(stage, key, given=None)
    autotune()
    _unsettle()
}

class RMSNormFwdOp #F4F3F6 {
    forward(x, weight=None)
    _eager_forward(x, weight=None)
}

class _Plan #E7EEF6 {
    sig
    checks
    effects
    construct(op)
    check(op, tensors) : SignatureCall
    output_shapes(op, shapes, dtypes)
    effect(op, present)
    roofline(call)
}

class _Boundary #E8F0E9 {
    plan : _Plan
    branches
    call(op, inputs, writes, execution)
    binder(cls)
    _register(name, written, out, emitted)
}

class SignatureCall #F7EEDC {
    ix
    tensors
    traffic
    metadata
    stages
    values(name)
    with_stages(stages)
}

RMSNormFwdOp -down-|> Op
Op "0..*" -down-> "0..1" _Plan : _signature (shared)
Op "0..*" -down-> "0..1" SignatureCall : _signature_call
_Plan -[hidden]right-> SignatureCall
Op .left.> _Boundary : dispatch
_Boundary -down-> _Plan : plan
_Plan .right.> SignatureCall : creates

@enduml
